rules_version = '2';
// =============================================================
// SISDIFI — Regras de segurança do Cloud Firestore
// Cole este conteúdo em: Console Firebase → Firestore Database → Regras → Publicar
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function caminhoUsuario() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function caminhoBootstrap() { return /databases/$(database)/documents/sistema/bootstrap; }
    function ativo() { return logado() && exists(caminhoUsuario()) && get(caminhoUsuario()).data.ativo == true; }
    function perfil() { return get(caminhoUsuario()).data.perfil; }
    function admin() { return ativo() && perfil() == 'admin'; }
    function operador() { return ativo() && perfil() in ['admin', 'operador']; }          // Contabilidade: cadastros
    function solicitante() { return ativo() && perfil() in ['admin', 'operador', 'secretaria']; }
    function secretaria() { return ativo() && perfil() == 'secretaria'; }
    function minhaSecretaria() { return get(caminhoUsuario()).data.secretaria_id; }
    function controleInterno() { return ativo() && perfil() == 'controle_interno'; }
    function contabilidade() { return ativo() && perfil() == 'operador'; }
    function rh() { return ativo() && perfil() == 'rh'; }
    function camposValor() { return ['valor_total', 'valor_pernoite', 'valor_simples', 'valor_alimentacao', 'quantidade_pernoite', 'quantidade_simples', 'quantidade_alimentacao', 'horas_total', 'faixa_codigo', 'faixa_texto', 'descricao_calculo', 'justificativa_legal', 'reembolsos', 'total_reembolsos']; }
    function podeVerValores() { return ativo() && perfil() in ['admin', 'operador', 'consulta']; }
    function alterou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos); }

    // Marca de "primeiro administrador já criado". Leitura pública (só contém o uid).
    match /sistema/bootstrap {
      allow get: if true;
      allow create: if logado()
        && !exists(caminhoBootstrap())
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // Admin cria qualquer usuário; ou o PRIMEIRO acesso cria o próprio admin junto com o bootstrap.
      allow create: if admin() || (
        logado() && request.auth.uid == uid
        && request.resource.data.perfil == 'admin'
        && request.resource.data.ativo == true
        && !exists(caminhoBootstrap())
        && existsAfter(caminhoBootstrap())
        && getAfter(caminhoBootstrap()).data.uid == request.auth.uid
      ) || (
        // Quem entra sem cadastro (ex.: Google) registra um pedido de acesso, sempre bloqueado até o admin liberar.
        logado() && request.auth.uid == uid
        && exists(caminhoBootstrap())
        && request.resource.data.ativo == false
        && request.resource.data.perfil == 'consulta'
        && request.resource.data.email == request.auth.token.email.lower()
      );
      // Só admin altera usuários, e não pode bloquear/rebaixar a si mesmo.
      allow update: if admin() && (uid != request.auth.uid || (request.resource.data.perfil == 'admin' && request.resource.data.ativo == true));
      allow delete: if false;
    }

    match /config/{doc} {
      allow read: if ativo();
      allow write: if admin();
    }

    match /secretarias/{id} {
      allow read: if ativo();
      allow create, update: if operador() && request.resource.data.nome is string && request.resource.data.nome.size() > 0;
      allow delete: if admin();
    }

    // Servidores — cadastro PÚBLICO (todos os usuários ativos leem): nome, cargo, categoria, lotação e indicadores.
    // CPF e chave Pix NÃO ficam aqui (LGPD): ficam em servidores_privado.
    function semDadoPessoal() {
      return !request.resource.data.keys().hasAny(['cpf', 'chave_pix', 'cpf_anterior'])
        || (resource != null && !alterou(['cpf', 'chave_pix', 'cpf_anterior'])); // registros antigos até a migração
    }
    match /servidores/{id} {
      allow read: if ativo();
      // Secretaria completa o cadastro: cargo quando está em branco (ou servidor da própria pasta) e o indicador de Pix.
      allow update: if secretaria()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargo_funcao', 'tem_pix', 'atualizado_em', 'atualizado_por'])
        && (!alterou(['tem_pix']) || request.resource.data.tem_pix == true)
        && (!alterou(['cargo_funcao']) || (request.resource.data.cargo_funcao is string && request.resource.data.cargo_funcao.size() > 0
            && (resource.data.get('cargo_funcao', '') == '' || resource.data.get('secretaria_id', '') == minhaSecretaria())));
      // Secretaria cadastra servidor novo na própria pasta, sempre em "Demais Servidores" (só a Contabilidade enquadra).
      allow create: if secretaria()
        && request.resource.data.secretaria_id == minhaSecretaria()
        && request.resource.data.nome is string
        && request.resource.data.grupo == 'DEMAIS_SERVIDORES'
        && semDadoPessoal();
      allow create, update: if operador()
        && request.resource.data.nome is string
        && request.resource.data.grupo in ['PREFEITO', 'VICE_SECRETARIO_JURIDICO', 'DEMAIS_SERVIDORES']
        && semDadoPessoal();
      allow delete: if admin();
    }

    // Servidores — área PRIVADA: CPF e chave Pix. Contabilidade, consulta e RH leem todos; a Secretaria, os da própria pasta.
    function lePrivado(secId) { return ativo() && (perfil() in ['admin', 'operador', 'consulta', 'rh'] || (secretaria() && secId == minhaSecretaria())); }
    match /servidores_privado/{id} {
      allow read: if lePrivado(resource.data.secretaria_id);
      allow create: if operador() || (secretaria() && request.resource.data.secretaria_id == minhaSecretaria()
        && request.resource.data.cpf is string && request.resource.data.cpf.size() == 11);
      // Secretaria inclui a chave Pix de quem está sem (qualquer pasta) ou altera a dos servidores da própria pasta.
      allow update: if operador() || (secretaria()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chave_pix'])
        && request.resource.data.chave_pix is string && request.resource.data.chave_pix.size() > 0
        && (resource.data.get('chave_pix', '') == '' || resource.data.get('secretaria_id', '') == minhaSecretaria()));
      allow delete: if admin();
    }

    // Índice de CPF: só responde a quem já sabe o CPF completo (get); ninguém lista.
    match /cpfs/{cpf} {
      allow get: if ativo();
      allow list: if false;
      allow create: if (operador() || secretaria()) && cpf.size() == 11 && request.resource.data.servidor_id is string;
      allow update: if operador();
      allow delete: if admin();
    }

    match /solicitacoes/{id} {
      // Contabilidade/admin/consulta: tudo. Secretaria: só as da própria pasta visíveis para ela (sem lançamento interno
      // e sem o histórico do sistema antigo). Controle Interno e RH: tudo, menos os lançamentos internos da Contabilidade.
      allow read: if ativo() && (
        perfil() in ['admin', 'operador', 'consulta']
        || (secretaria() && resource.data.secretaria_id == minhaSecretaria() && resource.data.visivel_secretaria == true)
        || (perfil() in ['controle_interno', 'rh'] && resource.data.interna == false));
      allow create: if solicitante()
        && request.resource.data.numero is string
        && request.resource.data.servidor_id is string
        && (podeVerValores() || !request.resource.data.keys().hasAny(camposValor()))
        && request.resource.data.interna is bool && request.resource.data.visivel_secretaria is bool
        && (!secretaria() || (request.resource.data.secretaria_id == minhaSecretaria() && request.resource.data.etapa == 'analise'
            && request.resource.data.interna == false && request.resource.data.visivel_secretaria == true
            // o número precisa ser o que o contador acabou de reservar (ninguém inventa numeração)
            && getAfter(/databases/$(database)/documents/contadores/$('solicitacoes-' + string(request.resource.data.ano))).data.ultimo == request.resource.data.sequencia));
      // Secretaria só altera/cancela enquanto está em análise ou reprovada, sem tocar em análise, autorização ou contabilidade.
      allow update: if secretaria()
        && request.resource.data.numero == resource.data.numero
        && resource.data.secretaria_id == minhaSecretaria()
        && request.resource.data.secretaria_id == minhaSecretaria()
        && resource.data.etapa in ['analise', 'reprovada']
        && request.resource.data.etapa in ['analise', 'reprovada']
        && !alterou(['analise', 'data_autorizacao', 'autorizacao_registrada_por', 'ficha', 'numero_empenho', 'data_empenho', 'data_liquidacao', 'data_pagamento', 'calculado', 'calculo_por', 'interna', 'visivel_secretaria', 'sequencia', 'ano'])
        && !alterou(camposValor());
      // Controle Interno: só aprova ou reprova solicitações em análise (grava apenas a análise e a etapa).
      allow update: if controleInterno()
        && resource.data.etapa == 'analise'
        && request.resource.data.etapa in ['aprovada', 'reprovada']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analise', 'etapa', 'historico', 'atualizado_em', 'atualizado_por']);
      // O número nunca muda. A Contabilidade não altera a análise do Controle Interno.
      allow update: if solicitante() && !secretaria()
        && request.resource.data.numero == resource.data.numero
        && !(contabilidade() && alterou(['analise']));
      allow delete: if admin();
    }

    // Valores das diárias: só Contabilidade, administrador e consulta leem. Secretaria e Controle Interno não.
    match /valores/{id} {
      // Controle Interno e RH: só os valores liberados (após o empenho). Secretaria: só os liberados da própria pasta.
      allow read: if podeVerValores()
        || ((controleInterno() || rh()) && resource.data.liberado_ci == true)
        || (secretaria() && resource.data.liberado_ci == true && resource.data.secretaria_id == minhaSecretaria());
      allow write: if operador();
    }

    // Orçamento: Contabilidade envia PDFs e cadastra fichas; cada Secretaria lê apenas os da própria pasta.
    function leOrcamento(secId) { return ativo() && (perfil() in ['admin', 'operador', 'consulta'] || (secretaria() && secId == minhaSecretaria())); }
    match /orcamentos/{id} {
      allow read: if leOrcamento(resource.data.secretaria_id);
      allow write: if operador();
      match /partes/{parte} {
        allow read: if leOrcamento(resource.data.secretaria_id);
        allow write: if operador();
      }
    }
    match /fichas/{id} {
      allow read: if leOrcamento(resource.data.secretaria_id);
      allow write: if operador();
    }

    // Exercícios (ano do orçamento): todos leem; a Contabilidade abre e registra as respostas.
    match /exercicios/{ano} {
      allow read: if ativo();
      allow write: if operador();
    }

    // Numeração: quem solicita só avança o contador de 1 em 1 (dentro da transação de criação).
    match /contadores/{id} {
      allow read: if ativo();
      allow write: if operador();
      allow create: if solicitante() && request.resource.data.ultimo == 1 && request.resource.data.keys().hasOnly(['ultimo', 'ano']);
      allow update: if solicitante() && request.resource.data.ultimo == resource.data.ultimo + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'ano']);
    }

    // Distâncias de referência: só a Contabilidade grava (confere o km ao calcular).
    match /distancias/{id} {
      allow read: if ativo();
      allow write: if operador() && request.resource.data.km is number && request.resource.data.km > 0 && request.resource.data.km < 6000;
    }

    // Auditoria: qualquer usuário ativo registra a própria ação; ninguém altera ou apaga.
    match /logs/{id} {
      allow read: if admin();
      allow create: if ativo() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
